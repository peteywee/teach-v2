        },
        "responsiblePersonId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "label",
        "responsiblePersonId"
      ]
    },
    "DemoPerson": {
      "type": "object",
