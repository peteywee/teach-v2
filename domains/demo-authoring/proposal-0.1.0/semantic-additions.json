      }
    },
    {
      "family": "entities",
      "entry": {
        "id": "AuthoringReceipt",
        "kind": "entity",
        "status": "approved",
        "owning_domain": "TransactionControl",
        "definition": "Append-only current-authority-scoped recovery receipt for SaveContentDraft or PublishContentDraft; separate from the existing three-learning-command CommandReceipt.",
        "requires": [
          {
            "family": "identifiers",
            "id": "AuthoringReceiptId"
          },
          {
            "family": "identifiers",
            "id": "DemoRunId"
          },
          {
            "family": "identifiers",
            "id": "IdentityId"
          },
          {
            "family": "identifiers",
            "id": "IdempotencyKey"
          },
          {
            "family": "identifiers",
            "id": "OrganizationId"
          },
          {
            "family": "identifiers",
            "id": "LocationId"
          },
          {
            "family": "commands",
            "id": "SaveContentDraft"
          },
          {
            "family": "commands",
            "id": "PublishContentDraft"
          }
        ],
        "identifier": "AuthoringReceiptId",
        "fields": {
          "id": "AuthoringReceiptId composite; no separate physical opaque-ID column",
          "operation": "SaveContentDraft | PublishContentDraft, bound payload but not identity",
          "payloadDigest": "canonical request SHA-256",
          "result": "bounded confirmed result only, not full catalog or credentials",
          "scope": "organization/location derived from immutable run",
          "expiresAt": "run-scoped replay deadline; current authority required before lookup"
        },
        "constraints": [
          "Identity is (DemoRunId, managerIdentityId:IdentityId, IdempotencyKey). Operation is not part of the uniqueness key.",
          "Cross-operation or changed-payload key reuse conflicts; identical replay is free and never publishes twice.",
          "Old successful save receipts remain valid when the mutable draft advances.",
          "At most 256 distinct receipt keys per visit; no UPDATE or DELETE."
        ],
        "demo_authoring_registration": {
          "package_id": "TEACH-DEMO-AUTHORING-2026-10-26",
          "package_version": "0.1.0",
          "approval_record": "domains/demo-authoring/owner-approval.json",
          "impact_issue": null,
          "registered_on": "2026-10-26"
        }
      }
    },
