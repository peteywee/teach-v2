            "id": "RequestId"
          },
          {
            "family": "identifiers",
            "id": "IdempotencyKey"
          }
        ],
        "capability": "content.draft.write",
        "authority": "Only a current HumanActor manager in the exact live demo run; no automation impersonation or general customer publication.",
        "constraints": [
          "Current scope/session/run fence before work and before commit.",
          "Uncertain response resolves through operation readback; never assumed success.",
          "No new creation audit or version on an unchanged publication."
        ],
        "demo_authoring_registration": {
