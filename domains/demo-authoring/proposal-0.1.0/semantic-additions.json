  "package_id": "TEACH-DEMO-AUTHORING-2026-10-26",
  "scope": "BOUNDED_PRIVATE_DEMO_AUTHORING",
  "entries": [
    {
      "family": "entities",
      "entry": {
        "id": "ContentDraft",
        "kind": "entity",
        "status": "approved",
        "owning_domain": "Content",
        "definition": "One private mutable working kitchen catalog per demo run, owned by its current manager identity; never learner content or an immutable publication.",
        "requires": [
          {
            "family": "identifiers",
            "id": "ContentDraftId"
          },
          {
            "family": "identifiers",
            "id": "DemoRunId"
          },
          {
            "family": "identifiers",
            "id": "IdentityId"
          },
          {
            "family": "identifiers",
            "id": "OrganizationId"
          },
          {
            "family": "identifiers",
            "id": "LocationId"
          },
          {
            "family": "identifiers",
            "id": "ContentPackId"
          },
          {
            "family": "values",
            "id": "ContentVersion"
          }
        ],
        "identifier": "ContentDraftId",
        "fields": {
          "id": "ContentDraftId",
          "demoRunId": "DemoRunId, immutable, unique",
          "managerIdentityId": "IdentityId, immutable",
          "scope": "immutable OrganizationId + LocationId derived from run",
          "baseContent": "exact immutable ContentPackId + ContentVersion + digest",
          "revision": "integer 1..100; compare-and-swap, not ContentVersion",
          "catalog": "bounded mutable schema-1.2 kitchen child values only",
          "catalogDigest": "SHA-256 digest of canonical catalog",
          "lastPublished": "nullable exact draft revision and immutable published content reference"
        },
        "constraints": [
          "Only SaveContentDraft and PublishContentDraft may mutate this representation after current manager/run authorization.",
          "No draft delete, learner read, real staff identity or live stock claim.",
          "Published content, questions, scoring, existing assignments and historical attempts remain unchanged.",
          "Revision and digest are draft evidence, not SemVer content identity."
        ],
        "demo_authoring_registration": {
          "package_id": "TEACH-DEMO-AUTHORING-2026-10-26",
          "package_version": "0.1.0",
          "approval_record": "domains/demo-authoring/owner-approval.json",
          "impact_issue": null,
          "registered_on": "2026-10-26"
        }
      }
    },
