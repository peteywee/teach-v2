{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t34ch.com/proposals/demo-kitchen-0.1.0/content-schema-1.2.0.json",
  "title": "Proposed canonical ContentPack schema 1.2.0",
  "status": "PROPOSED_SOURCE_NOT_SELF_AUTHORIZING",
  "$comment": "Bounded successor in the existing canonical ContentPack lineage. Catalog IDs are scoped to this pack/version; people and inventory are fictional display values, not operational entities. No network schema resolution.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.2.0"
    },
    "contentPackId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$(?![\\s\\S])"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 38,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$(?![\\s\\S])",
      "description": "Exact strict SemVer 2.0 identity, including prerelease and build metadata; ASCII syntax makes the 38-character and 38-byte bounds equal."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]|<[^>]*>|\\b(?:[A-Za-z][A-Za-z0-9+.-]*:\\/\\/|[hH][tT][tT][pP][sS]?:|[fF][tT][pP]:|[fF][iI][lL][eE]:|[dD][aA][tT][aA]:|[jJ][aA][vV][aA][sS][cC][rR][iI][pP][tT]:|[vV][bB][sS][cC][rR][iI][pP][tT]:|[mM][aA][iI][lL][tT][oO]:|[tT][eE][lL]:|[wW][wW][wW]\\.)|(?:^|[\\s(\"'])\\/\\/\\S+|[\\uD800-\\uDBFF](?![\\uDC00-\\uDFFF])|(?:^|[^\\uD800-\\uDBFF])[\\uDC00-\\uDFFF]))[\\s\\S]*$(?![\\s\\S])",
      "description": "Plain text measured in Unicode scalar values, with no normalization; excludes HTML, URL/media/script references, prohibited controls, and lone surrogates."
    },
    "blocks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/TeachingBlock"
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/StationRecipe"
      }
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/KitchenStation"
      }
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/DemoPerson"
      }
    },
    "equipment": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/EquipmentItem"
      }
    },
    "inventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "$ref": "#/$defs/InventoryHolding"
      }
    }
  },
  "required": [
    "schemaVersion",
    "contentPackId",
    "organizationId",
    "version",
    "title",
    "blocks",
    "recipes",
    "stations",
    "people",
    "equipment",
    "inventory"
  ],
  "$defs": {
    "TeachingBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$(?![\\s\\S])"
        },
        "kind": {
          "const": "SINGLE_CHOICE"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]|<[^>]*>|\\b(?:[A-Za-z][A-Za-z0-9+.-]*:\\/\\/|[hH][tT][tT][pP][sS]?:|[fF][tT][pP]:|[fF][iI][lL][eE]:|[dD][aA][tT][aA]:|[jJ][aA][vV][aA][sS][cC][rR][iI][pP][tT]:|[vV][bB][sS][cC][rR][iI][pP][tT]:|[mM][aA][iI][lL][tT][oO]:|[tT][eE][lL]:|[wW][wW][wW]\\.)|(?:^|[\\s(\"'])\\/\\/\\S+|[\\uD800-\\uDBFF](?![\\uDC00-\\uDFFF])|(?:^|[^\\uD800-\\uDBFF])[\\uDC00-\\uDFFF]))[\\s\\S]*$(?![\\s\\S])",
          "description": "Plain text measured in Unicode scalar values, with no normalization; excludes HTML, URL/media/script references, prohibited controls, and lone surrogates."
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]|<[^>]*>|\\b(?:[A-Za-z][A-Za-z0-9+.-]*:\\/\\/|[hH][tT][tT][pP][sS]?:|[fF][tT][pP]:|[fF][iI][lL][eE]:|[dD][aA][tT][aA]:|[jJ][aA][vV][aA][sS][cC][rR][iI][pP][tT]:|[vV][bB][sS][cC][rR][iI][pP][tT]:|[mM][aA][iI][lL][tT][oO]:|[tT][eE][lL]:|[wW][wW][wW]\\.)|(?:^|[\\s(\"'])\\/\\/\\S+|[\\uD800-\\uDBFF](?![\\uDC00-\\uDFFF])|(?:^|[^\\uD800-\\uDBFF])[\\uDC00-\\uDFFF]))[\\s\\S]*$(?![\\s\\S])",
          "description": "Plain text measured in Unicode scalar values, with no normalization; excludes HTML, URL/media/script references, prohibited controls, and lone surrogates."
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]|<[^>]*>|\\b(?:[A-Za-z][A-Za-z0-9+.-]*:\\/\\/|[hH][tT][tT][pP][sS]?:|[fF][tT][pP]:|[fF][iI][lL][eE]:|[dD][aA][tT][aA]:|[jJ][aA][vV][aA][sS][cC][rR][iI][pP][tT]:|[vV][bB][sS][cC][rR][iI][pP][tT]:|[mM][aA][iI][lL][tT][oO]:|[tT][eE][lL]:|[wW][wW][wW]\\.)|(?:^|[\\s(\"'])\\/\\/\\S+|[\\uD800-\\uDBFF](?![\\uDC00-\\uDFFF])|(?:^|[^\\uD800-\\uDBFF])[\\uDC00-\\uDFFF]))[\\s\\S]*$(?![\\s\\S])",
            "description": "Plain text measured in Unicode scalar values, with no normalization; excludes HTML, URL/media/script references, prohibited controls, and lone surrogates."
          }
        },
        "expectedOptionIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "feedback": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^(?![\\s\\S]*(?:[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]|<[^>]*>|\\b(?:[A-Za-z][A-Za-z0-9+.-]*:\\/\\/|[hH][tT][tT][pP][sS]?:|[fF][tT][pP]:|[fF][iI][lL][eE]:|[dD][aA][tT][aA]:|[jJ][aA][vV][aA][sS][cC][rR][iI][pP][tT]:|[vV][bB][sS][cC][rR][iI][pP][tT]:|[mM][aA][iI][lL][tT][oO]:|[tT][eE][lL]:|[wW][wW][wW]\\.)|(?:^|[\\s(\"'])\\/\\/\\S+|[\\uD800-\\uDBFF](?![\\uDC00-\\uDFFF])|(?:^|[^\\uD800-\\uDBFF])[\\uDC00-\\uDFFF]))[\\s\\S]*$(?![\\s\\S])",
            "description": "Plain text measured in Unicode scalar values, with no normalization; excludes HTML, URL/media/script references, prohibited controls, and lone surrogates."
          }
        }
      },
      "required": [
        "id",
        "kind",
        "instruction",
        "prompt",
        "options",
        "expectedOptionIndex",
        "feedback"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "options": {
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "options"
            ]
          },
          "then": {
            "properties": {
              "expectedOptionIndex": {
                "maximum": 1
              },
              "feedback": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "options": {
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "options"
            ]
          },
          "then": {
            "properties": {
              "expectedOptionIndex": {
                "maximum": 2
              },
              "feedback": {
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "options": {
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": [
              "options"
            ]
          },
          "then": {
            "properties": {
              "expectedOptionIndex": {
                "maximum": 3
              },
              "feedback": {
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "options": {
                "minItems": 5,
                "maxItems": 5
              }
            },
            "required": [
              "options"
            ]
          },
          "then": {
            "properties": {
              "expectedOptionIndex": {
                "maximum": 4
              },
              "feedback": {
                "minItems": 5,
                "maxItems": 5
              }
            }
          }
        }
      ]
    },
