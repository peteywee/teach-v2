{
 "x-document": {
  "doc_id": "TEACH-PROP-DCS-05-SCHEMA",
  "class": "specification",
  "version": "0.1.0",
  "status": "proposed",
  "owner": "Patrick Craven, Top Shelf Service LLC",
  "created_on": "2026-10-05",
  "updated_on": "2026-10-05"
 },
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://t34ch.com/schemas/proposals/api-error-envelope.schema.json",
 "title": "Teach v2 API error envelope",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "error"
 ],
 "properties": {
  "error": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "code",
    "message",
    "requestId"
   ],
   "properties": {
    "code": {
     "enum": [
      "UNAUTHENTICATED",
      "FORBIDDEN",
      "NOT_FOUND",
      "INVALID_REQUEST",
      "UNSUPPORTED_MEDIA_TYPE",
      "CONFLICT",
      "PRECONDITION_FAILED",
      "IDEMPOTENCY_KEY_REUSED",
      "RATE_LIMITED",
      "INTERNAL_ERROR",
      "SERVICE_UNAVAILABLE"
     ]
    },
    "message": {
     "type": "string",
     "description": "Fixed text per code (x-messages). Never interpolated with request, target, SQL, stack or tenant data (API-11, PRIV-4)."
    },
    "requestId": {
     "type": "string",
     "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "details": {
     "type": "array",
     "description": "Only for INVALID_REQUEST. Field locations and rule names; never submitted values.",
     "maxItems": 50,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "path",
       "rule"
      ],
      "properties": {
       "path": {
        "type": "string",
        "pattern": "^/[A-Za-z0-9_/~-]*$"
       },
       "rule": {
        "type": "string",
        "pattern": "^[a-z_]+$"
       }
      }
     }
    },
    "retryAfterSeconds": {
     "type": "integer",
     "minimum": 1,
     "description": "Only for RATE_LIMITED and SERVICE_UNAVAILABLE; mirrors Retry-After."
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "code": {
        "not": {
         "const": "INVALID_REQUEST"
        }
       }
      }
     },
     "then": {
      "not": {
       "required": [
        "details"
       ]
      }
     }
    }
   ]
  }
 },
 "x-status-by-code": {
  "UNAUTHENTICATED": 401,
  "FORBIDDEN": 403,
  "NOT_FOUND": 404,
  "INVALID_REQUEST": 400,
  "UNSUPPORTED_MEDIA_TYPE": 415,
  "CONFLICT": 409,
  "PRECONDITION_FAILED": 409,
  "IDEMPOTENCY_KEY_REUSED": 422,
  "RATE_LIMITED": 429,
  "INTERNAL_ERROR": 500,
  "SERVICE_UNAVAILABLE": 503
 },
 "x-messages": {
  "UNAUTHENTICATED": "Sign in to continue.",
  "FORBIDDEN": "You do not have access to this action.",
  "NOT_FOUND": "Not found.",
  "INVALID_REQUEST": "The request is not valid.",
  "UNSUPPORTED_MEDIA_TYPE": "Send JSON.",
  "CONFLICT": "The request conflicts with the current state.",
  "PRECONDITION_FAILED": "This action is not available yet.",
  "IDEMPOTENCY_KEY_REUSED": "This idempotency key was used with a different request.",
  "RATE_LIMITED": "Too many requests. Try again later.",
  "INTERNAL_ERROR": "Something went wrong.",
  "SERVICE_UNAVAILABLE": "Service unavailable."
 }
}