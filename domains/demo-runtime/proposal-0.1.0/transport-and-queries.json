  ],
  "internal_queries": [
    {
      "id": "ListExpiredDemoRuns",
      "owner": "Organization",
      "principal": "automation:demo-expiry-v1",
      "scope": "due DEMO_ONLY runs only",
      "limit": 100,
      "output": "DemoRunId+immutable organization/location/deadline; no content/learner data"
    }
  ],
  "wire_rules": {
    "additional_properties": false,
    "all_protected_cache": "no-store",
    "unsafe_content_type": "application/json",
    "exact_origin_required": true,
    "automatic_secret_issuance_retry": false,
    "idempotency_header": "Idempotency-Key only where existing registered operation requires it",
    "optional_query_parameters": [
      "assignmentId",
      "limit",
      "cursor"
    ],
    "list_order": "assignedAt then AssignmentId; team/membership lists by stable ID",
    "cursor": "base64url canonical last ordering tuple, validated syntax and ownership; it grants no authority",
    "error_schema": "baseline-error-envelope.schema.json",
    "rate_limit": {
      "status": 429,
      "code": "RATE_LIMITED",
      "message": "Too many requests. Try again later.",
      "retry_after": "only when a finite retry time is known"
    },
    "dependency_failure": {
      "status": 503,
      "code": "SERVICE_UNAVAILABLE",
      "message": "Service unavailable."
    },
    "unknown_target": "same404body for absent/other-scope targets",
    "unknown_or_expired_demo_session": "ordinary401body; no protected payload",
    "idempotency_payload_conflict": {
      "status": 422,
      "code": "IDEMPOTENCY_KEY_REUSED",
      "message": "This idempotency key was used with a different request."
    },
    "error_contract": "Byte-identical baseline-error-envelope.schema.json, including UUID-v4 requestId, fixed messages, constrained optional details/retryAfterSeconds and status map. Demo-specific explanation belongs in UI, not interpolated wire error."
  },
  "no_mount_authority": true,
  "content_version_pattern_revision": {
    "source": "governance/decision-closure/api-boundary-manifest.json#/content_version_pattern",
    "reason": "Existing core-only regex contradicts already-selected strict SemVer2.0 with prerelease/build preservation. This is an explicit representation reconciliation, not a new semantic version policy.",
    "proposed_pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
    "maximum_length": 38,
    "path_encoding": "Percent-encode version path segment; decode once, validate full exact string, never normalize build/prerelease identity."
  },
  "demo_lifetime_limits": {
    "minutes": 60,
    "assignments": 10,
    "learning_sessions": 10,
    "progress_events": 30,
    "application_sessions_including_history": 100,
    "close_available_at_cap": true
  }
