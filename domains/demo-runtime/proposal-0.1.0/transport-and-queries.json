  "queries": [
    {
      "id": "ReadCurrentSession",
      "owning_domain": "Identity",
      "input": "presented cookie only; no identity selector",
      "output": "CurrentSession",
      "predicate": "current Identity/ApplicationSession + live DemoRun; capability data is presentation only"
    },
    {
      "id": "ListOwnMemberships",
      "owning_domain": "Organization",
      "input": "presented cookie only",
      "output": "Memberships",
      "predicate": "current identity only, ACTIVE memberships; scopes read from database"
    },
    {
      "id": "ListTeam",
      "owning_domain": "Organization",
      "input": "explicit organization/location; limit20 default,max50;cursor max512",
      "output": "Team",
      "predicate": "current manager capability plus exact direct-report scope; no arbitrary people or public profiles"
    },
    {
      "id": "ListOwnAssignments",
      "owning_domain": "Learning",
      "capability": "learning.assignment.read_self",
      "matrix_pointer": "/operations/25",
      "route_pointer": "/routes/18",
      "input": "organizationId,locationId selectors; limit default 20 max 50; optional opaque cursor",
      "output": "ordered Assignment DTOs with content title, exact reference, session summary or null; nextCursor|null",
      "predicate": "current LOCATION learner grant; assignment.identityId == authenticated identity; scope exact"
    },
    {
      "id": "ReadAssignedContentVersion",
      "owning_domain": "Content",
      "capability": "content.pack.read_assigned",
      "matrix_pointer": "/operations/26",
      "route_pointer": "/routes/19",
      "input": "organizationId,locationId,contentPackId,exact contentVersion string",
      "output": "exact version/digest and public teaching payload: title, blocks id/kind/instruction/prompt/options only",
      "predicate": "current LOCATION learner grant and current ACTIVE own Assignment for exact version through Learning owner read; never return expectedOptionIndex or feedback before response"
    },
    {
      "id": "ReadOwnLearnerState",
      "owning_domain": "Learning",
      "capability": "learning.state.read_self",
      "matrix_pointer": "/operations/27",
      "route_pointer": "/routes/23",
      "input": "organizationId,locationId; optional AssignmentId; limit default 20 max 50, cursor",
      "output": "LearnerState projections including own recorded response/evaluation and next unrecorded block",
      "predicate": "current LOCATION learner grant and exact authenticated learner; no client learnerId"
    },
    {
      "id": "ReadTeamMemberLearnerState",
      "owning_domain": "Learning",
      "capability": "learning.state.read_team",
      "matrix_pointer": "/operations/30",
      "route_pointer": "/routes/16",
      "input": "organizationId,locationId,target identityId; optional AssignmentId; limit default 20 max 50,cursor",
      "output": "separate per-assignment LearnerState DTOs: exact content/title, requiredBlockCount,recordedBlockCount,session status,times; no choices,correctness fields or aggregate score",
      "predicate": "same authoritative current visibility as ListTeam (manager direct reports intersected with scope; org_admin organization membership); this demo grants only manager, never org_admin"
    }
  ],
