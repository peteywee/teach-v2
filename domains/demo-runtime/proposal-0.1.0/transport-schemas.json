{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t34ch.com/proposals/demo-runtime-0.1.0/transport-schemas.json",
  "status": "PROPOSED_NOT_APPROVED",
  "$defs": {
    "ContentVersion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 38,
          "description": "Strict SemVer2.0 including prerelease/build; validated by exact canonical parser."
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "digest"
      ]
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organizationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "locationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        }
      },
      "required": [
        "organizationId",
        "locationId"
      ]
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "identityId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "assignmentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "COMPLETED"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "identityId",
        "assignmentId",
        "status",
        "startedAt",
        "completedAt"
      ]
    },
    "Assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "identityId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "organizationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "locationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "contentPackId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "contentVersion": {
          "$ref": "#/$defs/ContentVersion"
        },
        "status": {
          "const": "ACTIVE"
        },
        "assignedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "identityId",
        "organizationId",
        "locationId",
        "contentPackId",
        "contentVersion",
        "status",
        "assignedAt"
      ]
    },
    "Evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engineVersion": {
          "const": "1.0.0"
        },
        "blockId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "selectedOptionIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "matchesExpectedChoice": {
          "type": "boolean"
        },
        "feedback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "engineVersion",
        "blockId",
        "selectedOptionIndex",
        "matchesExpectedChoice",
        "feedback"
      ]
    },
    "ProgressEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "learningSessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "contentPackId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "contentVersion": {
          "$ref": "#/$defs/ContentVersion"
        },
        "eventSchemaVersion": {
          "const": "1.0.0"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "evaluation": {
          "$ref": "#/$defs/Evaluation"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "learningSessionId",
        "contentPackId",
        "contentVersion",
        "eventSchemaVersion",
        "sequence",
        "evaluation",
        "recordedAt"
      ]
    },
    "AssignmentView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assignment": {
          "$ref": "#/$defs/Assignment"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/$defs/Session"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "assignment",
        "title",
        "session"
      ]
    },
    "StateBase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "projectionVersion": {
          "const": "1.0.0"
        },
        "identityId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "assignmentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "contentPackId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "contentVersion": {
          "$ref": "#/$defs/ContentVersion"
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/$defs/Session"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordedBlockCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "requiredBlockCount": {
          "const": 3
        },
        "nextBlockId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "projectionVersion",
        "identityId",
        "assignmentId",
        "contentPackId",
        "contentVersion",
        "title",
        "session",
        "recordedBlockCount",
        "requiredBlockCount",
        "nextBlockId"
      ]
    },
    "OwnState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "projectionVersion": {
          "const": "1.0.0"
        },
        "identityId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "assignmentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "contentPackId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "contentVersion": {
          "$ref": "#/$defs/ContentVersion"
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/$defs/Session"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordedBlockCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "requiredBlockCount": {
          "const": 3
        },
        "nextBlockId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "responses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProgressEvent"
          }
        }
      },
      "required": [
        "id",
        "projectionVersion",
        "identityId",
        "assignmentId",
        "contentPackId",
        "contentVersion",
        "title",
        "session",
        "recordedBlockCount",
        "requiredBlockCount",
        "nextBlockId",
        "responses"
      ]
    },
    "CurrentSession": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identityId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "displayLabel": {
          "enum": [
            "Alex, demo learner",
            "Jordan, demo manager"
          ]
        },
        "sessionExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "demo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "persona": {
              "enum": [
                "LEARNER",
                "MANAGER"
              ]
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            },
            "scope": {
              "$ref": "#/$defs/Scope"
            }
          },
          "required": [
            "runId",
            "persona",
            "expiresAt",
            "scope"
          ]
        },
        "allowedOperations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "synthetic": {
          "const": true
        }
      },
      "required": [
        "identityId",
        "displayLabel",
        "sessionExpiresAt",
        "demo",
        "allowedOperations",
        "synthetic"
      ]
    },
    "MembershipView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "organizationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "locationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "status": {
          "const": "ACTIVE"
        },
        "organizationLabel": {
          "const": "Demo workspace"
        },
        "locationLabel": {
          "const": "Practice location"
        },
        "synthetic": {
          "const": true
        }
      },
      "required": [
        "id",
        "organizationId",
        "locationId",
        "status",
        "organizationLabel",
        "locationLabel",
        "synthetic"
      ]
    },
    "TeamMember": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identityId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "displayLabel": {
          "const": "Alex, demo learner"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "synthetic": {
          "const": true
        }
      },
      "required": [
        "identityId",
        "displayLabel",
        "scope",
        "synthetic"
      ]
    },
    "PublicBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "kind": {
          "const": "SINGLE_CHOICE"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "required": [
        "id",
        "kind",
        "instruction",
        "prompt",
        "options"
      ]
    },
    "PublicContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contentPackId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "organizationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "contentVersion": {
          "$ref": "#/$defs/ContentVersion"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "blocks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/PublicBlock"
          }
        },
        "synthetic": {
          "const": true
        }
      },
      "required": [
        "contentPackId",
        "organizationId",
        "contentVersion",
        "schemaVersion",
        "title",
        "blocks",
        "synthetic"
      ]
    },
    "Assignments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssignmentView"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ]
    },
    "OwnStates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OwnState"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ]
    },
    "TeamStates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StateBase"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ]
    },
    "Memberships": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MembershipView"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ]
    },
    "Team": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TeamMember"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ]
    },
    "Error": {
      "$ref": "baseline-error-envelope.schema.json#"
    }
  }
}
