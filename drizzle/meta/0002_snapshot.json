        "transaction_control_reconciliation_status_outcome_check": {
          "name": "transaction_control_reconciliation_status_outcome_check",
          "value": "(\n        (\n          \"transaction_control_reconciliation_records\".\"status\" = 'OPEN'\n          AND \"transaction_control_reconciliation_records\".\"outcome\" IN ('AMBIGUOUS', 'PARTIAL_FAILURE')\n          AND \"transaction_control_reconciliation_records\".\"resolved_at\" IS NULL\n        )\n        OR\n        (\n          \"transaction_control_reconciliation_records\".\"status\" = 'RESOLVED'\n          AND \"transaction_control_reconciliation_records\".\"outcome\" IN ('CONFIRMED_SUCCESS', 'CONFIRMED_NO_EFFECT')\n          AND \"transaction_control_reconciliation_records\".\"resolved_at\" IS NOT NULL\n        )\n      )"
        },
        "transaction_control_reconciliation_idempotency_binding_check": {
          "name": "transaction_control_reconciliation_idempotency_binding_check",
          "value": "(\n        (\n          \"transaction_control_reconciliation_records\".\"idempotency_key\" IS NULL\n          AND \"transaction_control_reconciliation_records\".\"idempotency_key_source\" IS NULL\n          AND \"transaction_control_reconciliation_records\".\"payload_hash\" IS NULL\n          AND \"transaction_control_reconciliation_records\".\"retry_horizon_ends_at\" IS NULL\n          AND \"transaction_control_reconciliation_records\".\"idempotency_retention_until\" IS NULL\n        )\n        OR\n        (\n          \"transaction_control_reconciliation_records\".\"idempotency_key\" IS NOT NULL\n          AND \"transaction_control_reconciliation_records\".\"idempotency_key_source\" IN ('CLIENT_SUPPLIED', 'SERVER_DERIVED')\n          AND \"transaction_control_reconciliation_records\".\"payload_hash\" IS NOT NULL\n          AND \"transaction_control_reconciliation_records\".\"retry_horizon_ends_at\" IS NOT NULL\n          AND \"transaction_control_reconciliation_records\".\"idempotency_retention_until\" IS NOT NULL\n          AND \"transaction_control_reconciliation_records\".\"idempotency_retention_until\" >= \"transaction_control_reconciliation_records\".\"retry_horizon_ends_at\"\n        )\n      )"
        },
        "transaction_control_reconciliation_nonblank_check": {
          "name": "transaction_control_reconciliation_nonblank_check",
          "value": "\n        length(btrim(\"transaction_control_reconciliation_records\".\"id\")) > 0\n        AND length(btrim(\"transaction_control_reconciliation_records\".\"operation_name\")) > 0\n        AND length(btrim(\"transaction_control_reconciliation_records\".\"scope_fingerprint\")) > 0\n        AND length(btrim(\"transaction_control_reconciliation_records\".\"provider_name\")) > 0\n      "
        }
      },
