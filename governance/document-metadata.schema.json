{
  "x-document": {
    "doc_id": "TEACH-GOV-DOC-SCHEMA",
    "class": "governance-schema",
    "version": "1.0.0",
    "status": "active",
    "owner": "Patrick Craven, Top Shelf Service LLC",
    "created_on": "2026-10-03",
    "updated_on": "2026-10-03"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t34ch.com/schemas/document-metadata.schema.json",
  "title": "Teach v2 tos-doc metadata",
  "type": "object",
  "required": ["doc_id", "class", "version", "status", "owner", "created_on", "updated_on"],
  "properties": {
    "doc_id": { "type": "string", "minLength": 1 },
    "class": {
      "type": "string",
      "enum": ["contract", "contract-index", "approval-record", "source-record", "governance-policy", "semantic-kernel", "architecture-decision", "specification", "decision-table", "runbook", "evidence-summary"]
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "claims_truth_state": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["draft", "proposed", "active", "superseded", "retired", "recorded"]
    },
    "owner": { "type": "string", "minLength": 1 },
    "created_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "updated_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "effective_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "superseded_on": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "approval": { "type": "object" },
    "baseline": { "type": "object" },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "superseded_by": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
