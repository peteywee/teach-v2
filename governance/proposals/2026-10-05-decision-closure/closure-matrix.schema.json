{
  "x-document": {
    "doc_id": "TEACH-PROP-DCS-01-SCHEMA",
    "class": "specification",
    "version": "0.3.0",
    "status": "proposed",
    "owner": "Patrick Craven, Top Shelf Service LLC",
    "created_on": "2026-10-05",
    "updated_on": "2026-10-05"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t34ch.com/schemas/proposals/decision-closure-matrix.schema.json",
  "title": "Teach v2 decision-closure matrix",
  "type": "object",
  "required": [
    "x-document",
    "baseline",
    "derived_from",
    "policy_or_runtime_authority_changed",
    "owner_approval_recorded",
    "totals",
    "rows",
    "classification_baseline"
  ],
  "additionalProperties": false,
  "properties": {
    "x-document": {
      "type": "object"
    },
    "baseline": {
      "type": "object",
      "required": [
        "repo",
        "ref",
        "commit"
      ],
      "properties": {
        "repo": {
          "const": "peteywee/teach-v2"
        },
        "ref": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "derived_from": {
      "type": "object",
      "required": [
        "inventory_script",
        "answer_register",
        "answer_register_sha256",
        "contract_sha256"
      ],
      "properties": {
        "answer_register_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contract_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "policy_or_runtime_authority_changed": {
      "const": false
    },
    "owner_approval_recorded": {
      "const": false
    },
    "totals": {
      "type": "object",
      "required": [
        "rows",
        "explicit_blockers",
        "by_closure_class",
        "explicit_blockers_by_closure_class",
        "rows_with_missing_owner_values",
        "live_unresolved",
        "registered_since_classification"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "classification_baseline": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "owner_decision": {
      "type": "object"
    }
  },
  "$defs": {
    "closureClass": {
      "enum": [
        "READY_TO_REGISTER",
        "REGISTER_WITH_ARTIFACT",
        "REGISTER_AS_DISABLED",
        "REGISTER_SPLIT_RESIDUAL",
        "RECONCILE_DRAFT",
        "CONFIRM_RECOMMENDATION",
        "UNKNOWN_OWNER_VALUE"
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contract",
        "contract_version_live",
        "explicit_blocker",
        "affects",
        "question",
        "answer_register",
        "preserved_value",
        "closure_class",
        "owner_action",
        "repeat_original_question",
        "controlling_artifact",
        "missing_owner_values",
        "dependencies",
        "conflicts",
        "technical_notes",
        "registration_target",
        "evidence_required_to_mark_resolved",
        "implementation_evidence_is_separate",
        "state",
        "live_state",
        "registered_by",
        "semantic_assertions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^OQ-[A-Z]+-[0-9]+$"
        },
        "contract": {
          "type": "string",
          "pattern": "^contracts/c[0-9]{2}-[a-z0-9-]+\\.md$"
        },
        "contract_version_live": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "explicit_blocker": {
          "type": "boolean"
        },
        "affects": {
          "type": "string"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "answer_register": {
          "type": "object",
          "required": [
            "path",
            "record_index",
            "capture_state",
            "recorded_detail_state",
            "packet_answer_sha256",
            "follow_up_sha256"
          ],
          "properties": {
            "capture_state": {
              "const": "ANSWER_RECEIVED_UNREGISTERED"
            },
            "record_index": {
              "type": "integer",
              "minimum": 0
            },
            "packet_answer_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "follow_up_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "preserved_value": {
          "type": "object"
        },
        "closure_class": {
          "$ref": "#/$defs/closureClass"
        },
        "owner_action": {
          "type": "string"
        },
        "repeat_original_question": {
          "const": false
        },
        "controlling_artifact": {
          "type": "string",
          "pattern": "^governance/proposals/2026-10-05-decision-closure/0[2-9]-[a-z0-9-]+\\.md$"
        },
        "missing_owner_values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^OQ-[A-Z]+-[0-9]+$"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "technical_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "registration_target": {
          "type": "object",
          "required": [
            "contract",
            "from_version",
            "bump",
            "procedure"
          ],
          "properties": {
            "bump": {
              "enum": [
                "MINOR",
                "MAJOR"
              ]
            },
            "procedure": {
              "const": "SYS-21"
            }
          }
        },
        "evidence_required_to_mark_resolved": {
          "type": "array",
          "minItems": 6
        },
        "implementation_evidence_is_separate": {
          "const": true
        },
        "state": {
          "const": "PROPOSED"
        },
        "live_state": {
          "enum": [
            "UNRESOLVED",
            "RESOLVED"
          ]
        },
        "registered_by": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^#[0-9]+$"
        },
        "semantic_assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "contains",
              "must_not_contain"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(contracts|governance)/"
              },
              "contains": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "must_not_contain": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "closure_class": {
                "enum": [
                  "REGISTER_SPLIT_RESIDUAL",
                  "UNKNOWN_OWNER_VALUE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "missing_owner_values": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "closure_class": {
                "enum": [
                  "READY_TO_REGISTER",
                  "REGISTER_WITH_ARTIFACT",
                  "REGISTER_AS_DISABLED",
                  "RECONCILE_DRAFT"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "missing_owner_values": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "live_state": {
                "const": "RESOLVED"
              }
            }
          },
          "then": {
            "properties": {
              "registered_by": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}