    {
      "id": "DT-003",
      "name": "AmbiguousExternalEffectRetry",
      "owning_domain": "TransactionControl",
      "authority_contracts": [
        "C22"
      ],
      "requirements": [
        "TXN-2",
        "TXN-6",
        "TXN-7",
        "TXN-8",
        "TXN-9"
      ],
      "inputs": [
        "external_outcome",
        "provider_readback",
        "documented_idempotency_strategy"
      ],
      "rules": [
        {
          "when": "external_outcome=AMBIGUOUS and provider_readback=UNREADABLE",
          "outcome": "DEFER_NEEDS_RECONCILIATION"
        },
        {
          "when": "external_outcome=AMBIGUOUS and provider_readback=SUCCESS",
          "outcome": "RECONCILE_SUCCESS_NO_RETRY"
        },
        {
          "when": "external_outcome=AMBIGUOUS and provider_readback=NO_EFFECT and documented_idempotency_strategy=true",
          "outcome": "RETRY_ALLOWED"
        },
        {
          "when": "external_outcome=AMBIGUOUS and provider_readback=NO_EFFECT and documented_idempotency_strategy!=true",
          "outcome": "DEFER_NO_SAFE_RETRY"
        }
      ],
      "default_outcome": "DEFER_NO_SAFE_RETRY",
      "failure_behavior": "Never resend while external outcome remains ambiguous.",
      "kind": "decision_table",
      "status": "candidate"
    },
    {
      "id": "DT-004",
      "name": "EvidenceGate",
      "owning_domain": "VerificationEvidence",
      "authority_contracts": [
        "C00",
        "C51"
      ],
      "requirements": [
        "SYS-13",
        "SYS-14",
        "SYS-25",
        "EVD-1",
        "EVD-2",
        "EVD-10",
        "EVD-11",
        "EVD-12",
        "EVD-13",
        "EVD-14",
        "EVD-15"
      ],
      "inputs": [
        "required_evidence_states",
        "source_sha_match",
        "environment_match",
        "runtime_evidence_required",
        "runtime_evidence_present"
      ],
      "rules": [
        {
          "when": "any required evidence is UNKNOWN/BLOCKED/CONTRADICTORY/missing/stale/unreadable/skipped",
          "outcome": "FAIL"
        },
        {
          "when": "source_sha_match=false or environment_match=false",
          "outcome": "FAIL"
        },
        {
          "when": "runtime_evidence_required=true and runtime_evidence_present=false",
          "outcome": "FAIL"
        },
        {
          "when": "all required evidence is PROVEN and exact-candidate/environment conditions pass",
          "outcome": "PASS"
        }
      ],
      "default_outcome": "FAIL",
      "failure_behavior": "No evidence gap can collapse to PASS.",
      "kind": "decision_table",
      "status": "candidate"
    },
    {
      "id": "DT-005",
      "name": "SemanticAdmission",
      "owning_domain": "Governance",
