    {
      "id": "DT-009",
      "kind": "decision_table",
      "status": "approved",
      "owning_domain": "Content",
      "definition": "ContentPublicationValidation: deterministic validation and immutable version collision decision.",
      "requires": [
        {
          "family": "entities",
          "id": "ContentPack"
        },
        {
          "family": "values",
          "id": "ContentVersion"
        },
        {
          "family": "entities",
          "id": "ContentBlock"
        }
      ],
      "name": "ContentPublicationValidation",
      "inputs": [
        "declaredSchemaSupported:boolean",
        "canonicalPayloadValid:boolean",
        "organizationMatches:boolean",
        "suppliedDigestMatches:boolean",
        "existingVersionDigest:null|string",
        "requestedDigest:string"
      ],
      "rules": [
        {
          "when": "Any input unknown, malformed, or one of the first four booleans false",
          "outcome": "REJECT_INVALID_REQUEST"
        },
        {
          "when": "All first four true and existingVersionDigest == null",
          "outcome": "CREATE_IMMUTABLE_PUBLICATION"
        },
        {
          "when": "All first four true and existingVersionDigest == requestedDigest",
          "outcome": "RETURN_EXISTING_NO_EFFECT"
        },
        {
          "when": "All first four true and existingVersionDigest != null and != requestedDigest",
          "outcome": "REJECT_CONFLICT"
        }
      ],
      "default": "REJECT_INVALID_REQUEST",
      "constraints": [
        "Caller authority/current demo run admission are checked by Authorization before this Content-owned table.",
        "No approval claim, draft state or external publication effect is created."
      ],
      "demo_runtime_registration": {
        "package_id": "TEACH-DEMO-RUNTIME-2026-10-17",
        "package_version": "0.1.0",
        "approval_record": "domains/demo-runtime/owner-approval.json",
        "issue": "#82",
        "registered_on": "2026-10-17"
      }
    },
    {
      "id": "DT-010",
      "kind": "decision_table",
      "status": "approved",
      "owning_domain": "Learning",
      "definition": "LearningResponseAndCompletionGate: deterministic new-write admission after current authorization and receipt handling.",
      "requires": [
        {
          "family": "entities",
          "id": "LearningSession"
        },
        {
          "family": "entities",
          "id": "ProgressEvent"
        },
        {
          "family": "entities",
          "id": "Assignment"
        },
        {
          "family": "entities",
          "id": "ContentBlock"
        },
        {
          "family": "states",
          "id": "LearningSessionStatus"
        },
        {
          "family": "values",
          "id": "ContentResponseEvaluation"
        }
      ],
      "name": "LearningResponseAndCompletionGate",
      "inputs": [
        "operation:RecordProgressEvent|CompleteLearningSession",
        "sessionStatus:LearningSessionStatus",
        "contentValid:boolean",
        "RecordProgressEvent only: blockExists:boolean, blockAlreadyRecorded:boolean, requestedSequence:integer, expectedNextSequence:integer, optionIndexValid:boolean",
        "CompleteLearningSession only: recordedRequiredCount:integer, requiredCount:integer"
      ],
      "rules": [
        {
          "priority": 1,
          "when": "Operation, sessionStatus, contentValid or operation-required inputs unknown/malformed; content invalid; or session not ACTIVE",
          "outcome": "REJECT_NO_WRITE"
        },
        {
          "priority": 2,
          "when": "RecordProgressEvent and (blockExists == false or optionIndexValid == false)",
          "outcome": "REJECT_INVALID_REQUEST"
        },
        {
          "priority": 3,
          "when": "RecordProgressEvent and (blockAlreadyRecorded == true or requestedSequence != expectedNextSequence)",
          "outcome": "REJECT_CONFLICT"
        },
        {
          "priority": 4,
          "when": "RecordProgressEvent and blockExists and optionIndexValid and not blockAlreadyRecorded and requestedSequence == expectedNextSequence",
          "outcome": "EVALUATE_AND_APPEND"
        },
        {
          "priority": 5,
          "when": "CompleteLearningSession and requiredCount == 3 and recordedRequiredCount == 3",
          "outcome": "TRANSITION_COMPLETED"
        },
        {
          "priority": 6,
          "when": "CompleteLearningSession and requiredCount == 3 and 0 <= recordedRequiredCount < 3",
          "outcome": "REJECT_PRECONDITION_FAILED"
        }
      ],
      "default": "REJECT_NO_WRITE",
      "constraints": [
        "Recorded count is recomputed from unique persisted event rows inside the locked transaction; never accepted from client.",
        "No comparison to matchesExpectedChoice in completion eligibility.",
        "Rules are first-match in priority order. Only the inputs for the selected operation are required; unused operation inputs are absent, not unknown failures."
      ],
      "demo_runtime_registration": {
        "package_id": "TEACH-DEMO-RUNTIME-2026-10-17",
        "package_version": "0.1.0",
        "approval_record": "domains/demo-runtime/owner-approval.json",
        "issue": "#82",
        "registered_on": "2026-10-17"
      }
    }
