    {
      "id": "DT-002",
      "name": "AuthorizationOutcome",
      "owning_domain": "Authorization",
      "authority_contracts": [
        "C14"
      ],
      "requirements": [
        "AUTHZ-10",
        "AUTHZ-11",
        "AUTHZ-12",
        "AUTHZ-13",
        "AUTHZ-14",
        "AUTHZ-15",
        "AUTHZ-16",
        "AUTHZ-17"
      ],
      "inputs": [
        "session_valid",
        "identity_active",
        "membership_active",
        "scope_valid",
        "capability_present",
        "target_visible",
        "entitlement_allows"
      ],
      "rules": [
        {
          "when": "session_valid=false or identity_active=false",
          "outcome": "DENY_401"
        },
        {
          "when": "session_valid=true and identity_active=true and membership_active=false",
          "outcome": "DENY_403"
        },
        {
          "when": "session_valid=true and identity_active=true and membership_active=true and scope_valid=false",
          "outcome": "DENY_403"
        },
        {
          "when": "session_valid=true and identity_active=true and membership_active=true and scope_valid=true and capability_present=false",
          "outcome": "DENY_403"
        },
        {
          "when": "session_valid=true and identity_active=true and membership_active=true and scope_valid=true and capability_present=true and target_visible=false",
          "outcome": "DENY_404_NON_DISCLOSING"
        },
        {
          "when": "all authority checks pass and entitlement_allows=false",
          "outcome": "DENY_403"
        },
        {
          "when": "all authority checks pass and entitlement_allows=true",
          "outcome": "ALLOW"
        }
      ],
      "default_outcome": "DENY_404_NON_DISCLOSING",
      "failure_behavior": "Denied outcomes produce no mutation or external side effect except permitted audit.",
      "kind": "decision_table",
      "status": "approved",
      "definition": "AuthorizationOutcome",
      "requires": [],
      "constraints": [
        "Retain baseline definition except exact DT002/DT008 corrections in decision-and-scope.md and contract-amendments.md.",
