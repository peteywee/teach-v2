    {
      "id": "DT-001",
      "name": "PrivilegedCommandGate",
      "owning_domain": "Authorization",
      "authority_contracts": [
        "C02",
        "C14",
        "C41"
      ],
      "requirements": [
        "AGT-8",
        "AGT-10",
        "API-14",
        "AUTHZ-11",
        "AUTHZ-15"
      ],
      "inputs": [
        "identity_or_execution_identity",
        "capability",
        "scope",
        "command_registration",
        "domain_invariants",
        "transaction_rule",
        "audit_rule"
      ],
      "rules": [
        {
          "when": "any prerequisite is false/unknown",
          "outcome": "DENY"
        },
        {
          "when": "all prerequisites are true",
          "outcome": "ALLOW_COMMAND"
        }
      ],
      "default_outcome": "DENY",
      "failure_behavior": "No protected handler/domain side effect executes before all gates pass.",
      "kind": "decision_table",
      "status": "approved",
      "definition": "PrivilegedCommandGate",
      "requires": [],
      "constraints": [
        "Retain baseline definition except exact DT002/DT008 corrections in decision-and-scope.md and contract-amendments.md.",
