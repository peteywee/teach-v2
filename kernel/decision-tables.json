        "usage_context"
      ],
      "rules": [
        {
          "when": "term_registered=false",
          "outcome": "REJECT_OR_PROPOSE_SEMANTIC_CHANGE"
        },
        {
          "when": "entry_status=candidate and usage_context in [active_contract,merged_implementation]",
          "outcome": "REJECT"
