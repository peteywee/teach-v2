          "outcome": "REJECT_INPUT_NO_SIDE_EFFECT"
        },
        {
          "when": "required_scope_selector_present=false",
          "outcome": "DENY"
        },
        {
          "when": "server_scope_resolved=false or target_scope_resolved=false",
          "outcome": "DENY"
        },
        {
          "when": "client_authority_claim_present=true",
          "outcome": "IGNORE_CLIENT_AUTHORITY_AND_VALIDATE_REQUIRED_SELECTOR_SERVER_SIDE"
        },
        {
          "when": "all server-side checks pass and required scope selector is validated",
          "outcome": "CONTINUE"
        }
      ],
      "default_outcome": "DENY",
      "failure_behavior": "The required explicit scope tuple is a selector validated against database-current authority; client authority claims never grant tenant or target access.",
