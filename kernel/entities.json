      "id": "Invitation",
      "kind": "entity",
      "status": "candidate",
      "definition": "Identity-domain record representing an invitation into an identity/setup flow.",
      "identifier": "InvitationId",
      "owning_domain": "Identity",
      "relationships": [],
      "authority_implications": [
        "Does not grant membership, role, capability, or authentication authority by itself.",
        "Offboarded-email handling remains fail-closed under IDN-20 until OQ-IDN-5 is decided."
      ],
      "lifecycle": {
        "state": "blocked",
        "authority_contracts": [
          "C11"
        ],
        "requirements": [
          "IDN-9",
          "IDN-10",
          "IDN-11",
          "IDN-16",
          "IDN-20"
        ],
        "blocked_by": [
          "OQ-IDN-2",
          "OQ-IDN-5",
          "semantic-decision:invitation-lifecycle-state-set"
        ],
        "notes": "The active contract requires expiry, one-time consumption, revocation behavior and fail-closed offboarded-email handling, but does not define a complete canonical Invitation lifecycle state vocabulary."
      }
    },
