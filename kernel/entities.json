      "kind": "entity",
      "status": "candidate",
      "definition": "Single-use identity credential used to authorize a password-reset flow.",
      "identifier": "PasswordResetTokenId",
      "owning_domain": "Identity",
      "relationships": [],
      "authority_implications": [
        "Possession does not establish membership, role, or capability.",
        "Only a cryptographic hash may be stored.",
        "A revoked, expired, consumed, or otherwise invalid token must not authenticate."
      ],
      "lifecycle": {
        "state": "blocked",
        "authority_contracts": [
          "C11"
        ],
        "requirements": [
          "IDN-7",
          "IDN-8",
          "IDN-9",
          "IDN-10",
          "IDN-11",
          "IDN-14",
          "IDN-18"
        ],
        "blocked_by": [
          "OQ-IDN-2",
          "semantic-decision:single-use-token-lifecycle-state-set"
        ],
        "notes": "General single-use token behavior is normative, but canonical lifecycle state names and the owner-approved reset-token lifetime are not yet defined."
      }
    },
