      "kind": "entity",
      "status": "candidate",
      "definition": "Transaction-control record that captures an ambiguous external-effect outcome and the authoritative reconciliation readback used before any retry.",
      "identifier": "ReconciliationRecordId",
      "owning_domain": "TransactionControl",
      "relationships": [],
      "authority_implications": [
        "An ambiguous external side effect may not be retried until canonical provider state is read.",
        "Failure to read provider state preserves a non-success ambiguous condition."
      ],
      "lifecycle": {
        "state": "blocked",
        "authority_contracts": [
          "C22"
        ],
        "requirements": [
          "TXN-6",
          "TXN-7",
          "TXN-8",
          "TXN-9"
        ],
        "blocked_by": [
          "semantic-decision:reconciliation-lifecycle-state-set"
        ],
        "notes": "C22 requires explicit ambiguous and partial-failure states, but a complete canonical ReconciliationRecord state vocabulary has not yet been registered."
      }
    },
