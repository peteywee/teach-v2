      "id": "CapabilityId",
      "kind": "identifier",
      "definition": "The canonical string identifier of a Capability action constant, using the exact C14 capability vocabulary.",
      "identifier": null,
      "identifier_note": "This record defines an identifier type. Its own registry identity is id=CapabilityId; it does not have a second independently allocated business identifier.",
      "value_type": "string",
      "represents": "Capability",
      "requires": [
        "Capability"
      ],
      "validation": {
        "pattern": "^[a-z]+\\.[a-z]+\\.[a-z_]+$",
        "allowed_values_source": "kernel/capabilities.json"
      },
      "authority_implications": [
        "A valid identifier string is not a capability grant.",
        "C01 owns naming; C14 owns authorization semantics.",
        "Unknown names fail closed.",
        "The existing candidate status is unchanged."
      ],
      "definition_sources": [
        "kernel/identifiers.json#CapabilityId",
