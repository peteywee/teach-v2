{
  "schema_version": "0.1.0",
  "entries": [
    {
      "id": "ApplicationSessionStateMachine",
      "kind": "state_machine",
      "status": "candidate",
      "entity": "ApplicationSession",
      "state_set": "ApplicationSessionStatus",
      "owning_domain": "Identity",
      "authority_contracts": [
        "C01",
        "C12"
      ],
      "initial_state": "ACTIVE",
      "transitions": [
        {
          "from": "ACTIVE",
          "to": "EXPIRED",
          "trigger_kind": "system_condition",
          "trigger": "expiry"
        },
        {
          "from": "ACTIVE",
          "to": "REVOKED",
          "command": "RevokeApplicationSession",
          "event": "ApplicationSessionRevoked"
        }
      ],
      "terminal_states": [
        "EXPIRED",
        "REVOKED"
      ]
    },
    {
      "id": "IdentityStateMachine",
      "kind": "state_machine",
      "status": "candidate",
      "entity": "Identity",
      "state_set": "IdentityStatus",
      "owning_domain": "Identity",
      "authority_contracts": [
        "C01",
        "C11"
      ],
      "initial_state": "ACTIVE",
      "transitions": [
        {
          "from": "ACTIVE",
          "to": "INACTIVE",
          "command": "DeactivateIdentity",
          "event": "IdentityDeactivated"
        },
        {
          "from": "INACTIVE",
          "to": "ACTIVE",
          "command": "ReactivateIdentity",
          "event": "IdentityReactivated"
        },
        {
          "from": "ACTIVE",
          "to": "INACTIVE",
          "command": "OffboardIdentity",
          "event": "IdentityOffboarded"
        }
      ],
      "idempotent_operations": [
        {
          "state": "INACTIVE",
          "command": "OffboardIdentity",
          "result_state": "INACTIVE",
          "notes": "State remains INACTIVE; C11 idempotency and total-offboarding effects still apply."
        }
      ],
      "terminal_states": [
        "DELETED"
      ],
      "blocked_transitions": [
        {
          "to": "DELETED",
          "reason": "No application ingress is authorized until C15 privacy/deletion semantics are owner-approved."
        }
      ]
    },
    {
      "id": "InvitationStateMachine",
      "kind": "state_machine",
      "status": "approved",
      "entity": "Invitation",
      "state_set": "InvitationStatus",
      "owning_domain": "Identity",
      "authority_contracts": [
        "C01",
        "C11"
      ],
      "initial_state": "PENDING",
      "transitions": [
        {
          "from": "PENDING",
          "to": "ACCEPTED",
          "command": "AcceptInvitation"
        },
        {
          "from": "PENDING",
          "to": "REVOKED",
          "command": "RevokeInvitation"
        },
        {
          "from": "PENDING",
          "to": "EXPIRED",
          "trigger_kind": "system_condition",
          "trigger": "expiry"
        }
      ],
      "terminal_states": [
        "ACCEPTED",
        "REVOKED",
        "EXPIRED"
      ],
      "promotion_evidence": [
        "IDN-24",
        "IDN-27",
        "IDN-28"
      ]
    },
    {
      "id": "LearningSessionStateMachine",
      "kind": "state_machine",
      "status": "candidate",
      "entity": "LearningSession",
      "state_set": "LearningSessionStatus",
      "owning_domain": "Learning",
      "authority_contracts": [
        "C01",
        "C32"
      ],
      "initial_state": "ACTIVE",
      "creation_command": "StartLearningSession",
      "creation_event": "LearningSessionStarted",
      "allowed_operations": [
        {
          "state": "ACTIVE",
          "command": "RecordProgressEvent",
          "event": "ProgressRecorded"
        }
      ],
      "transitions": [
        {
          "from": "ACTIVE",
          "to": "COMPLETED",
          "command": "CompleteLearningSession",
          "event": "LearningSessionCompleted"
        }
      ],
      "terminal_states": [
        "COMPLETED"
      ]
    },
    {
      "id": "MembershipStateMachine",
      "kind": "state_machine",
      "status": "candidate",
      "entity": "Membership",
      "state_set": "MembershipStatus",
      "owning_domain": "Organization",
      "authority_contracts": [
        "C01",
        "C13"
      ],
      "initial_state": "ACTIVE",
      "creation_command": "CreateMembership",
      "creation_event": "MembershipCreated",
      "transitions": [
        {
          "from": "ACTIVE",
          "to": "INACTIVE",
          "command": "DeactivateMembership",
          "event": "MembershipDeactivated"
        },
        {
          "from": "INACTIVE",
          "to": "REVOKED",
          "command": "RevokeMembership",
          "event": "MembershipRevoked"
        }
      ],
      "terminal_states": [
        "REVOKED"
      ]
    },
    {
      "id": "PasswordResetTokenStateMachine",
      "kind": "state_machine",
      "status": "approved",
      "entity": "PasswordResetToken",
      "state_set": "SingleUseTokenStatus",
      "owning_domain": "Identity",
      "authority_contracts": [
        "C01",
        "C11"
      ],
      "initial_state": "ACTIVE",
      "transitions": [
        {
          "from": "ACTIVE",
          "to": "CONSUMED",
          "command": "ChangeCredential",
          "condition": "PasswordResetToken authorizes successful credential change"
        },
        {
          "from": "ACTIVE",
          "to": "REVOKED",
          "command": "RevokeSingleUseToken"
        },
        {
          "from": "ACTIVE",
          "to": "EXPIRED",
          "trigger_kind": "system_condition",
          "trigger": "expiry"
        }
      ],
      "terminal_states": [
        "CONSUMED",
        "EXPIRED",
        "REVOKED"
      ],
      "promotion_evidence": [
        "IDN-9",
        "IDN-10",
        "IDN-11",
        "IDN-26"
      ]
    },
    {
      "id": "ReconciliationRecordStateMachine",
      "kind": "state_machine",
      "status": "approved",
      "entity": "ReconciliationRecord",
      "state_set": "ReconciliationRecordStatus",
      "owning_domain": "TransactionControl",
      "authority_contracts": [
        "C01",
        "C22"
      ],
      "initial_state": "OPEN",
      "transitions": [
        {
          "from": "OPEN",
          "to": "RESOLVED",
          "command": "ReconcileExternalEffect",
          "condition": "canonical provider readback establishes CONFIRMED_SUCCESS or CONFIRMED_NO_EFFECT"
        }
      ],
      "terminal_states": [
        "RESOLVED"
      ],
      "no_transition_conditions": [
        {
          "condition": "provider state unreadable",
          "state_remains": "OPEN",
          "outcome_remains": "AMBIGUOUS or PARTIAL_FAILURE",
          "retry_allowed": false
        }
      ],
      "promotion_evidence": [
        "TXN-14",
        "TXN-15",
        "TXN-16"
      ]
    },
    {
      "id": "SetupTokenStateMachine",
      "kind": "state_machine",
      "status": "approved",
      "entity": "SetupToken",
      "state_set": "SingleUseTokenStatus",
      "owning_domain": "Identity",
      "authority_contracts": [
        "C01",
        "C11"
      ],
      "initial_state": "ACTIVE",
      "transitions": [
        {
          "from": "ACTIVE",
          "to": "CONSUMED",
          "command": "ChangeCredential",
          "condition": "SetupToken authorizes successful credential change"
        },
        {
          "from": "ACTIVE",
          "to": "REVOKED",
          "command": "RevokeSingleUseToken"
        },
        {
          "from": "ACTIVE",
          "to": "EXPIRED",
          "trigger_kind": "system_condition",
          "trigger": "expiry"
        }
      ],
      "terminal_states": [
        "CONSUMED",
        "EXPIRED",
        "REVOKED"
      ],
      "promotion_evidence": [
        "IDN-9",
        "IDN-10",
        "IDN-11",
        "IDN-26"
      ]
    }
  ]
}
