    {
      "id": "ContentVersion",
      "kind": "value_object",
      "status": "approved",
      "definition": "Immutable exact version and digest of one ContentPack, never a latest/range selector.",
      "owning_domain": "Content",
      "requires": [],
      "version": "strict SemVer 2.0 string, 1..38 UTF-8 bytes",
      "digest": "sha256: followed by exactly 64 lowercase hexadecimal digits",
      "constraints": [
        "Every reference also binds ContentPackId; the owning pack binds exactly one organization.",
        "Exact string equality includes prerelease and build metadata; SemVer precedence is not identity.",
        "Digest is SHA-256 of canonical schema payload bytes, not of arbitrary JSON serialization."
      ],
      "demo_runtime_registration": {
        "package_id": "TEACH-DEMO-RUNTIME-2026-10-17",
