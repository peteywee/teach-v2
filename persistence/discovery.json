      "id": "PERS-F01",
      "state": "PROVEN",
      "authority": [
        "MIG-1",
        "MIG-4",
        "MIG-5",
        "MIG-8"
      ],
      "finding": "Drizzle migration history is the current schema authority; shared/production schema changes occur only through immutable ordered migrations."
    },
    {
      "id": "PERS-F02",
      "state": "PROVEN",
      "authority": [
        "ARC-2",
        "ARC-4",
        "APP-5"
      ],
      "finding": "Each mutable record has one owning runtime module and foreign-domain repository/table writes are forbidden."
    },
    {
      "id": "PERS-F03",
      "state": "PROVEN",
      "authority": [
        "PRIV-1",
        "PRIV-3"
      ],
      "finding": "Protected records require explicit ownership/scope and data-access-layer scope predicates."
    },
    {
      "id": "PERS-F04",
      "state": "PROVEN",
      "authority": [
        "AUD-2",
        "AUD-4",
        "AUD-6"
      ],
      "finding": "Required audit writes share the mutation transaction and audit/lifecycle records are append-only at the persistence boundary."
    },
    {
      "id": "PERS-F05",
      "state": "PROVEN",
      "authority": [
        "MIG-11",
        "MIG-12"
      ],
      "finding": "Backend-owned tables must not be readable/writable by browser-reachable database roles; applicable privilege/RLS posture is testable."
    },
    {
      "id": "PERS-F06",
      "state": "PROVEN",
      "authority": [
        "SEM-2",
        "SEM-36",
        "ARC-10"
      ],
      "finding": "Candidate semantic identifiers, relationships, state sets, and entities are not implementation authority for physical schema."
    }
