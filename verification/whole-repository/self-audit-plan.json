      ],
      "timeout_ms": 25000,
      "dynamic_input": "source-bound-event-document-base"
    },
    {
      "id": "production-contract-decisions",
      "command": "node",
      "args": [
        "scripts/release/validate-production-proof-contract-decisions.mjs"
      ],
      "timeout_ms": 25000
